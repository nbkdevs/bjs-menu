{
  "manifest_version": 3,
  "name": "Peach Facet Collage",
  "version": "2.0.0",
  "description": "A warm peach geometric collage theme with sky-blue facets and teal accents — inspired by modern art new-tab designs.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "theme": {
    "images": {
      "theme_frame": "images/theme_frame.png",
      "theme_frame_inactive": "images/theme_frame_inactive.png",
      "theme_toolbar": "images/theme_toolbar.png",
      "theme_tab_background": "images/theme_tab_background.png",
      "theme_ntp_background": "images/theme_ntp_background.png"
    },
    "colors": {
      "frame": [13, 115, 119],
      "frame_inactive": [245, 183, 155],
      "toolbar": [247, 245, 240],
      "tab_text": [43, 43, 43],
      "tab_background_text": [106, 100, 94],
      "bookmark_text": [43, 43, 43],
      "ntp_background": [245, 183, 155],
      "ntp_text": [43, 43, 43],
      "ntp_link": [13, 115, 119],
      "ntp_header": [0, 163, 255],
      "ntp_section": [255, 253, 249],
      "ntp_section_text": [43, 43, 43],
      "ntp_section_link": [13, 115, 119],
      "button_background": [255, 253, 249]
    },
    "tints": {
      "buttons": [0.0, 0.0, 0.35],
      "frame": [-1.0, -1.0, -1.0],
      "frame_inactive": [0.05, 0.25, 0.7],
      "background_tab": [0.05, 0.2, 0.75]
    },
    "properties": {
      "ntp_background_alignment": "center",
      "ntp_background_repeat": "no-repeat",
      "ntp_logo_alternate": 1
    }
  }
}
